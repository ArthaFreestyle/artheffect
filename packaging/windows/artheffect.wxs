<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Artheffect" Manufacturer="Artheffect contributors" Version="$(var.Version)" UpgradeCode="862DF5F5-13AD-4946-AF73-80714749D708" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Artheffect motion graphics and visual effects" Manufacturer="Artheffect contributors" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Artheffect is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- The setup wizard (installer-ui.wxs): pick the folder on a fresh install. -->
    <UIRef Id="ArtheffectUI" />

    <Icon Id="ArtheffectIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ArtheffectIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ArthaFreestyle/artheffect" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ArthaFreestyle/artheffect/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ArthaFreestyle/artheffect/issues" />

    <!-- An upgrade, repair or silent reinstall goes where the installed copy already is: the App Paths
         "Path" value written below, or for releases before this installer change (no Path value; they
         could be put elsewhere with INSTALLFOLDER=...) the folder of the artheffect.exe that App Paths names. A
         "file" search with no FileSearch inside yields that file's folder. A folder passed on the
         command line (INSTALLFOLDER=...) wins. -->
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Type="directory" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artheffect.exe" Name="Path" />
    </Property>
    <Property Id="PREVIOUSEXEFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousExeFolder" Root="HKLM" Type="file" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artheffect.exe" />
    </Property>
    <!-- The desktop shortcut: on by default for a fresh install (a box in the wizard, or
         DESKTOPSHORTCUT=0 silently); an upgrade keeps what the installed copy chose, and adds none
         to an install from before this option. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="PREVIOUSDESKTOPSHORTCUT" Secure="yes">
      </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[PREVIOUSDESKTOPSHORTCUT]" After="CraftLoadOption1U" Sequence="both" Condition="WIX_UPGRADE_DETECTED" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Artheffect" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Artheffect" Level="1">
      <ComponentGroupRef Id="ArtheffectFiles" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Type="raw" Key="Software\Artheffect" Name="DesktopShortcut" />
    </Property><SetProperty Id="PREVIOUSDESKTOPSHORTCUT" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Type="raw" Key="Software\Artheffect" Name="DesktopShortcut" />
    </Property><SetProperty Id="PREVIOUSDESKTOPSHORTCUT" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <ComponentGroup Id="ArtheffectFiles" Directory="INSTALLFOLDER">
      <Component Id="ArtheffectNotice">
        <File Id="ArtheffectNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="ArtheffectApp" Guid="BA719860-95FE-4154-B265-47006B8E9083">
        <File Id="ArtheffectExe" Source="$(var.BinDir)\artheffect.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Artheffect" Description="Artheffect motion graphics and visual effects" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="ArtheffectIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artheffect.exe" Value="[#ArtheffectExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artheffect.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />
        <!-- The desktop shortcut choice, for the next upgrade (empty: none). -->
        <RegistryValue Root="HKMU" Key="Software\Artheffect" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Artheffect" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="ArtheffectCli">
        <File Id="ArtheffectCliExe" Source="$(var.BinDir)\artheffect-cli.exe" KeyPath="yes" />
      </Component>

      <!-- A component under the user's profile folders needs an HKCU key path (ICE38, ICE43). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Artheffect" Description="Artheffect motion graphics and visual effects" Target="[#ArtheffectExe]" WorkingDirectory="INSTALLFOLDER" Icon="ArtheffectIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Artheffect" Name="DesktopShortcut" Value="1" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
